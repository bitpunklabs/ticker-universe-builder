  "measurement": {
    "liquidity": {
      "basis": "measured",
      "method": "cross-sectional percentile of 30d USDT-quoted notional turnover on Binance",
      "window": "30d",
      "source": "https://data.binance.vision/"
    },
    "factor_r2": {
      "basis": "measured",
      "method": "OLS of daily returns on the 00_A BTC/ETH/SOL factors",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "independence": {
      "basis": "measured",
      "method": "derived as 100 - factor_r2 by the builder",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "beta_strength": {
      "basis": "measured",
      "method": "OLS beta against the 00_A factor basket",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "beta_stability": {
      "basis": "measured",
      "method": "agreement of the beta estimate across 30/90/180d windows",
      "window": "30/90/180d",
      "source": "https://data.binance.vision/"
    },
    "quality": {
      "basis": "judged",
      "method": "protocol revenue durability and ecosystem role read from official documentation"
    },
    "heat": {
      "basis": "judged",
      "method": "turnover jump confirmed against exchange data, never a single-day price move"
    }
  },
