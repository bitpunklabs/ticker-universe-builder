      "kind": "market_data",
      "tier": 2
    }
  ],
  "measurement": {
    "liquidity": {
      "basis": "measured",
      "method": "cross-sectional percentile of mean daily turnover",
      "window": "30d",
      "source": "https://data.binance.vision/"
    },
    "quality": {
      "basis": "blended",
      "method": "listing age and size percentile against a judged durability read",
      "source": "https://api.binance.com/api/v3/exchangeInfo"
    },
    "heat": {
      "basis": "judged",
      "method": "turnover jump confirmed against exchange data, never a single-day move"
    },
    "beta_strength": {
      "basis": "measured",
      "method": "absolute OLS beta against the 00_A BTC/ETH/SOL basket, beta 2.0 reads 100",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "beta_stability": {
      "basis": "measured",
      "method": "agreement of the beta estimate across the two halves of the window",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "factor_r2": {
      "basis": "measured",
      "method": "OLS of daily returns on the 00_A BTC/ETH/SOL basket",
      "window": "180d",
      "source": "https://data.binance.vision/"
    },
    "independence": {
      "basis": "measured",
      "method": "derived as 100 - factor_r2 by the builder",
      "window": "180d",
      "source": "https://data.binance.vision/"
    }
  },
