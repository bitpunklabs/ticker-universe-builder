  "measurement": {
    "liquidity": {
      "basis": "measured",
      "method": "percentile en coupe transversale du volume quotidien moyen",
      "window": "30d",
      "source": "https://live.euronext.com/en/markets/paris/equities/list",
      "population": 64
    },
    "quality": {
      "basis": "blended",
      "method": "ancienneté de cotation et percentile de taille, complétés par un jugement de durabilité",
      "source": "https://live.euronext.com/en/markets/paris/equities/list"
    },
    "heat": {
      "basis": "judged",
      "method": "saut de volume confirmé par les données de marché, jamais une séance isolée"
    },
    "beta_strength": {
      "basis": "measured",
      "method": "valeur absolue du bêta OLS contre EURONEXT:CAC ; un bêta de 2,0 vaut 100",
      "window": "180d",
      "source": "https://live.euronext.com/en/markets/paris/equities/list"
    },
    "beta_stability": {
      "basis": "measured",
      "method": "concordance de l'estimation du bêta entre les deux moitiés de la fenêtre",
      "window": "180d",
      "source": "https://live.euronext.com/en/markets/paris/equities/list"
    },
    "independence": {
      "basis": "measured",
      "method": "100 moins le R² de la régression des rendements quotidiens sur EURONEXT:CAC",
      "window": "180d",
      "source": "https://live.euronext.com/en/markets/paris/equities/list"
    }
  },
